#!/bin/sh

STATE_FILE="${TMPDIR:-/tmp}/theme-switcher-state"

if defaults read 'Apple Global Domain' AppleInterfaceStyle >/dev/null 2>&1; then
  current=dark
else
  current=light
fi

last=$(cat "$STATE_FILE" 2>/dev/null)

if [ "$current" != "$last" ]; then
  ~/.dotfiles/bin/"$current" && echo "$current" >"$STATE_FILE"
fi
